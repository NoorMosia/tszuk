---
import ContactForm from './ContactForm.astro';
---

<footer class="footer">
  <div class="footer__inner">
    <div class="footer__content">
      <h2 class="footer__headline">Ready to strip away the noise?</h2>
      <ContactForm />
    </div>
    <div class="footer__info">
      <div class="footer__contact">
        <a href="mailto:hello@tszuk.com" class="footer__link">hello@tszuk.com</a>
        <p class="footer__location">Port Elizabeth, South Africa</p>
      </div>
      <div class="footer__social">
        <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="footer__social-link" aria-label="Instagram">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
            <circle cx="12" cy="12" r="5"/>
            <circle cx="17.5" cy="6.5" r="1.5" fill="currentColor" stroke="none"/>
          </svg>
        </a>
        <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="footer__social-link" aria-label="LinkedIn">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
            <path d="M8 11v5M8 8v.01M12 16v-5c0-1.5 1-2 2-2s2 .5 2 2v5"/>
          </svg>
        </a>
      </div>
      <p class="footer__copy">&copy; 2026 tszuk. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--color-dark);
    color: var(--color-white);
    padding: var(--section-padding-mobile) 1.5rem;
  }

  .footer__inner {
    max-width: var(--content-max-width);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
  }

  .footer__headline {
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    font-weight: var(--font-weight-bold);
    margin-bottom: 2.5rem;
    line-height: 1.2;
  }

  .footer__info {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .footer__contact {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer__link {
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.9rem;
    transition: color var(--duration-hover) var(--easing);
  }

  .footer__link:hover {
    color: var(--color-accent);
  }

  .footer__location {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.5);
  }

  .footer__social {
    display: flex;
    gap: 1rem;
  }

  .footer__social-link {
    color: rgba(255, 255, 255, 0.8);
    transition: color var(--duration-hover) var(--easing);
  }

  .footer__social-link:hover {
    color: var(--color-accent);
  }

  .footer__copy {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.4);
    margin-top: 1rem;
  }

  @media (min-width: 768px) {
    .footer {
      padding: var(--section-padding) 2rem;
    }

    .footer__inner {
      grid-template-columns: 1.5fr 1fr;
      gap: 6rem;
    }

    .footer__info {
      justify-content: flex-end;
      padding-bottom: 1rem;
    }
  }
</style>
